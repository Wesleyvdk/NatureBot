generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Levels {
  id      String  @id @default(uuid())
  userId  String
  guildId String
  name    String
  exp     Int     @default(0)
  level   Int     @default(1)
}

model LevelRoles {
  id      String  @id @default(uuid()) // Unique role ID
  guildId String
  level   Int
  roleId  String
}

model Currency {
  id       String  @id @default(uuid())
  userId   String
  guildId  String
  name     String
  bank     Int
  cash     Int
  bitcoin  Int
}

model Settings {
  id        String  @id @default(uuid())
  guildId   String
  command   String
  category  String
  turnedOn  Boolean
}

model CommandUsage {
  id          String @id @default(uuid())
  command     String @unique
  category    String
  usageCount  Int     @default(0)
}

model IgnoredChannels {
  id         String  @id @default(uuid()) // Unique ID
  channelId  String  @unique // Channel ID
  guildId    String
  status     String  // "ignore messages", "ignore commands", or "ignore all"
}